{
    "mcpServers":  {
                       "filmcraft":  {
                                         "args":  [
                                                      "--bridge",
                                                      "127.0.0.1:8765",
                                                      "mcp"
                                                  ],
                                         "command":  "{{FILMCRAFT_CLI}}"
                                     },
                       "effectcraft":  {
                                           "args":  [
                                                        "mcp",
                                                        "--autosave",
                                                        "--automation-read-root",
                                                        "{{REPO_ROOT}}",
                                                        "--automation-write-root",
                                                        "{{REPO_ROOT}}"
                                                    ],
                                           "command":  "{{EFFECTCRAFT_CLI}}"
                                       },
                       "photocraft":  {
                                          "args":  [
                                                       "mcp",
                                                       "--automation-read-root",
                                                       "{{REPO_ROOT}}",
                                                       "--automation-write-root",
                                                       "{{REPO_ROOT}}"
                                                   ],
                                          "command":  "{{PHOTOCRAFT_CLI}}"
                                      },
                       "soundcraft":  {
                                          "args":  [
                                                       "mcp",
                                                       "--automation-read-root",
                                                       "{{REPO_ROOT}}",
                                                       "--automation-write-root",
                                                       "{{REPO_ROOT}}"
                                                   ],
                                          "command":  "{{SOUNDCRAFT_CLI}}"
                                      }
                   }
}
