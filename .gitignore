# ==========================================
# GitIgnore para EditorVideo - FilmCraft + Antigravity
# ==========================================

# Archivos del sistema operativo
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.env
venv/
env/
ENV/

# Node / Remotion
node_modules/
.remotion/
package-lock.json

# Archivos temporales de trabajo
scratch/
temp/
tmp/
*.tmp
*.log

# Exportaciones pesadas de video y miniaturas (GitHub bloquea archivos > 100MB)
# Se conservan los archivos .gitkeep y los manifiestos JSON de auditoría
PROYECTOS/**/03_exports/*
!PROYECTOS/**/03_exports/.gitkeep
!PROYECTOS/**/03_exports/*.json
PROYECTOS/**/02_filmcraft/*.mp4

# Videos y audios pesados generados de trabajo en demos (>50MB)
PROYECTOS/2026-10-24_mediflow-demo/01_fuentes/audio/*.wav
PROYECTOS/2026-10-24_mediflow-demo/01_fuentes/musica/
PROYECTOS/2026-10-24_mediflow-demo/01_fuentes/video/
PROYECTOS/2026-10-26_accesibilidad-rural/01_fuentes/audio/*.wav
PROYECTOS/2026-10-26_accesibilidad-rural/01_fuentes/musica/*.wav
PROYECTOS/2026-10-26_accesibilidad-rural/01_fuentes/musica/*.mp3
PROYECTOS/2026-10-26_accesibilidad-rural/01_fuentes/video/
PROYECTOS/2026-10-26_accesibilidad-rural/01_fuentes/graficos/*.mov
PROYECTOS/2026-10-26_aniversario-ccollana-condes/01_fuentes/
PROYECTOS/2026-10-26_cumbia-tecnologia-rural/01_fuentes/
INGESTA/

# FilmCraft temporales / autosave
*.fcproj.backup
*.fcproj.tmp
**/Auto-Save/
**/02_filmcraft/Auto-Save/
**/02_filmcraft/*.mp4

# Configuraciones locales no versionadas
HERRAMIENTAS/config.local.json
.agents/mcp_config.json

# Audio temporal sin comprimir de renderizado
*.raw.wav
