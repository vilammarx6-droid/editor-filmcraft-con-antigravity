# Auto detect text files and perform LF normalization
* text=auto

# Scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.ttf binary
*.otf binary
*.fcproj binary
