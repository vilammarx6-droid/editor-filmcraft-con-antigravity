:null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"}},{"id":5,"kind":"Audio","name":"Audio 2","items":[{"id":43,"item":23,"name":"musica_indie_tech_palmas_300s.wav","label":"Caribbean","start":0,"duration":76204800000000,"source_in":0,"speed":1.0,"reverse":false,"enabled":true,"link":null,"group":null,"effects":[{"effect":"volume","enabled":true,"params":{"bypass":{"value":{"Bool":false}},"level":{"value":{"Float":0.0}}}},{"effect":"channel_volume","enabled":true,"params":{"bypass":{"value":{"Bool":false}},"left":{"value":{"Float":0.0}},"right":{"value":{"Float":0.0}}}},{"effect":"panner","enabled":true,"params":{"balance":{"value":{"Float":0.0}}}}],"markers":[],"gain_db":0.0,"frame_hold":null,"scale_to_frame":false}],"transitions":[],"locked":false,"sync_lock":true,"enabled":true,"muted":false,"solo":false,"channels":"Stereo","volume_db":-14.0,"pan":0.0,"effects":[],"mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"}},{"id":6,"kind":"Audio","name":"Audio 3","items":[{"id":44,"item":24,"name":"sfx_mediflow_300s.wav","label":"Caribbean","start":0,"duration":76204800000000,"source_in":0,"speed":1.0,"reverse":false,"enabled":true,"link":null,"group":null,"effects":[{"effect":"volume","enabled":true,"params":{"bypass":{"value":{"Bool":false}},"level":{"value":{"Float":0.0}}}},{"effect":"channel_volume","enabled":true,"params":{"bypass":{"value":{"Bool":false}},"left":{"value":{"Float":0.0}},"right":{"value":{"Float":0.0}}}},{"effect":"panner","enabled":true,"params":{"balance":{"value":{"Float":0.0}}}}],"markers":[],"gain_db":0.0,"frame_hold":null,"scale_to_frame":false}],"transitions":[],"locked":false,"sync_lock":true,"enabled":true,"muted":false,"solo":false,"channels":"Stereo","volume_db":-6.0,"pan":0.0,"effects":[],"mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"}}],"markers":[],"mark_in":null,"mark_out":null,"work_area":null,"start_timecode":0,"master_volume_db":0.0,"master_effects":[],"master_mixer":{"mode":"Read","output":null,"record_arm":false,"solo_safe":false,"input_map":"Stereo"},"submix_tracks":[],"caption_tracks":[{"id":46,"name":"subtitulos_mediflow","format":"Subtitle","language":"en","style":{"font":"Inter","size":54.0,"color":[255,255,255,255],"background":true,"background_color":[0,0,0,191],"align":"Center","anchor":"Bottom","margin":0.08,"line_spacing":1.25,"outline":0.0,"outline_color":[0,0,0,255]},"enabled":true,"locked":false,"sync_lock":true,"captions":[{"id":47,"start":101606400000,"duration":5605286400000,"text":"¿Alguna vez te has puesto a pensar qué se siente estar en una sala de emergencias esperando un resultado médico, mientras ves a los doctores corriendo de un lado a otro y perdiendo minutos valiosos buscando papeles? Ahí es donde nace MediFlow, y no te lo cuento como un software más, sino como una solución pensada para devolvernos el tiempo y la calma. Mira este mapa en pantalla, es como un camino inteligente de once pasos que cuida cada documento para que nada se pierda.","speaker":null,"cue_id":null,"settings":""},{"id":48,"start":5943974400000,"duration":3192134400000,"text":"Y ponte por un momento en los zapatos de Carlos, que llegó con un dolor agudo en el pecho y cuyo informe de tomografía fue leído por el agente en solo tres segundos, mandando una alerta directa a Slack para que la guardia lo atendiera de inmediato.","speaker":null,"cue_id":null,"settings":""},{"id":49,"start":11049696000000,"duration":6130252800000,"text":"Fíjate cómo la Dra. Sofía carga la orden en urgencias y MediFlow valida la calidad al 100% sin que nadie tenga que abrir un correo a mano. En segundos, el caso entra a la Cola de Urgencias Médicas, el canal de Slack avisa a todo el equipo de guardia con el enlace directo al expediente, y cada evidencia queda respaldada de forma inmutable en la nube de Cloudflare R2, verificando dato por dato desde la cédula del paciente hasta la firma médica.","speaker":null,"cue_id":null,"settings":""},{"id":50,"start":20829312000000,"duration":3573158400000,"text":"O mira el caso de Luisa, donde pasa algo que a mí me encanta: el sistema no se cree perfecto, si encuentra una duda en la orden médica no improvisa jamás, se detiene con humildad y le pide a un especialista de carne y hueso que confirme la decisión con un clic.","speaker":null,"cue_id":null,"settings":""},{"id":51,"start":26925696000000,"duration":9347788800000,"text":"Porque en medicina, la prudencia también salva vidas. Cuando el documento de Luisa llega con una prioridad contradictoria, MediFlow jamás adivina ni descarta el archivo: frena el flujo, lo coloca en Revisión Humana y le entrega el control al Dr. Alejandro. Sigue el cursor a la derecha de la pantalla: el especialista contrasta el documento original frente a los datos extraídos, selecciona la prioridad confirmada de rutina, escribe su justificación médica auditable y hace clic en resolver y registrar destino. Al instante, MediFlow retoma el flujo autónomo, entrega el estudio a Laboratorio, notifica en Slack y sella la auditoría en la nube.","speaker":null,"cue_id":null,"settings":""},{"id":52,"start":43944768000000,"duration":2108332800000,"text":"Y para chicos como Kevin, significa que el día de su alta su historia clínica queda impecable con once estados verificables y respaldados en la nube.","speaker":null,"cue_id":null,"settings":""},{"id":53,"start":48517056000000,"duration":9483264000000,"text":"Aquí el Dr. Mateo audita cómo el resumen de alta de Kevin se procesa de principio a fin con una limpieza admirable. Mientras recorremos su expediente en pantalla, observa cómo cada hallazgo clínico, desde sus signos vitales de ingreso y radiografía de tórax hasta su diagnóstico de egreso y plan de control, queda estructurado con 100% de consistencia documental. Al bajar por el historial del documento, vemos cada etapa verificada con hora y responsable: recibido, validado, clasificado, extraído, evaluado, enrutado y entregado, sincronizando al mismo tiempo el canal de historia clínica en Slack y el almacenamiento inmutable en Cloudflare R2.","speaker":null,"cue_id":null,"settings":""},{"id":54,"start":68584320000000,"duration":3361478400000,"text":"Y puede abrir su teléfono en el portal de pacientes y ver sus exámenes sin hacer una sola fila ni pedir copias fotostáticas. Con solo ingresar su documento de identidad, Kevin consulta y descarga su historia clínica desde su casa.","speaker":null,"cue_id":null,"settings":""},{"id":55,"start":73664640000000,"duration":2430086400000,"text":"Porque al final del día MediFlow no se trata de líneas de código, se trata de nosotros, logrando que los médicos pasen menos tiempo buscando papeles y mucho más tiempo salvando vidas.","speaker":null,"cue_id":null,"settings":""}],"vtt_blocks":[]},{"id":45,"name":"Subtitulos","format":"Subtitle","language":"en","style":{"font":"Inter","size":54.0,"color":[255,255,255,255],"background":true,"background_color":[0,0,0,191],"align":"Center","anchor":"Bottom","margin":0.08,"line_spacing":1.25,"outline":0.0,"outline_color":[0,0,0,255]},"enabled":true,"locked":false,"sync_lock":true,"captions":[],"vtt_blocks":[]}]}},"metadata":{},"created":7},"8":{"id":8,"name":"escena_01_flujograma_effectcraft.mp4","label":"Violet","kind":{"Media":{"media":{"File":{"path":"C:\\Users\\marx_\\OneDrive\\Documentos\\Proyecto predeterminado\\EditorVideo\\PROYECTOS\\2026-10-24_mediflow-demo\\01_fuentes\\video\\escena_01_flujograma_effectcraft.mp4"}},"info":{"name":"escena_01_flujograma_effectcraft.mp4","kind":"Movie","duration":6350400000000,"video":{"width":1920,"height":1080,"frame_rate":{"num":30,"den":1},"par":[1,1],"codec":"H.264 (High)","pixel_format":"YUV 4:2:0 8-bit","color":{"matrix":"Bt709","transfer":"Bt709","primaries":"Bt709","range":"Limited"},"has_alpha":false,"bitrate":11972598},"audio_streams":[],"container":"MPEG-4","start_timecode":null,"file_size":37422270},"interpret":{"frame_rate":null,"par":null,"ignore_alpha":fal